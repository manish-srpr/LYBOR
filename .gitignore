# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local SQLite database. Not anchored to the root: the Prisma CLI and the app
# agree on <root>/dev.db, but a stray prisma/dev.db has appeared before when
# the two disagreed, and a root-only rule let it through as untracked - one
# `git add .` from being committed. Match the database anywhere, along with the
# journal and WAL sidecars SQLite writes beside it.
*.db
*.db-journal
*.db-wal
*.db-shm
