# Copy this file to .env before running the app:
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets to .env.example.

# SQLite for the prototype. A relative file: path resolves against the repo
# root. Swap for a PostgreSQL URL to move off SQLite (see README).
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Must be at least 16 characters.
# Generate your own before running:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-16-chars"

NODE_ENV="development"
